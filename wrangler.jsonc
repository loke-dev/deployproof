{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deployproof",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "deployproof.loke.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
